{
  "schema": "mercurio.view.v1",
  "version": 1,
  "kind": "diagram.state_machine",
  "mode": "visualization",
  "diagram": {
    "version": 1,
    "kind": "state_machine",
    "title": "controller modes",
    "root": "StateViews::Controller",
    "query": {
      "relations": [
        "specializes",
        "subsets"
      ],
      "direction": "children",
      "depth": 5,
      "include_libraries": true,
      "include_user_model": true,
      "max_nodes": 350,
      "max_edges": 900
    },
    "layout": {
      "engine": "dagre",
      "direction": "TB"
    },
    "style": {
      "show_attributes": true,
      "show_edge_labels": false,
      "group_by_layer": false,
      "show_affordances": false
    }
  }
}
