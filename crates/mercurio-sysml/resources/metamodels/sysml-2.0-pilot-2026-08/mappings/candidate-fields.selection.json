  "extensions": [
    {
      "field": "is_library",
      "kind": "Scalar",
      "source": {
        "classification": "kir-compatibility",
        "reason": "Retain the existing lowering flag alongside canonical LibraryPackage identity."
      }
    },
    {
      "field": "annotated_element",
      "kind": "ReferenceList",
      "source": {
        "classification": "kir-shape-override",
        "pilot_features": [
          "KerML::AnnotatingElement::annotatedElement",
          "KerML::Annotation::annotatedElement",
          "SysML::AnnotatingElement::annotatedElement",
          "SysML::Annotation::annotatedElement"
        ],
        "reason": "Shared KIR navigation stores annotating-element targets as a list; Annotation singleton targets are accepted by ReferenceList."
      }
    },
    {
      "field": "expression_is_result",
      "kind": "Scalar",
      "source": {
        "classification": "kir-compatibility",
        "reason": "Preserve whether the authored expression is a result body, separate from a feature initializer; the ResultExpressionMembership carries canonical ownership."
      }
    },
    {
      "field": "value",
      "kind": "Scalar",
      "source": {
        "classification": "kir-shape-override",
        "pilot_features": [
          "KerML::LiteralBoolean::value",
          "KerML::LiteralInteger::value",
          "KerML::LiteralRational::value",
          "KerML::LiteralString::value",
          "SysML::LiteralBoolean::value",
          "SysML::LiteralInteger::value",
          "SysML::LiteralRational::value",
          "SysML::LiteralString::value"
        ],
        "reason": "Literal expression values use their scalar Ecore shape. FeatureValue.value has a separate reference shape; kind-sensitive reference projection remains in G07-G08."
      }
    },
    {
      "field": "source",
      "kind": "ReferenceList",
      "source": {
        "classification": "kir-shape-override",
        "pilot_features": [
          "KerML::Relationship::source",
          "SysML::Relationship::source",
          "SysML::TransitionUsage::source"
        ],
        "reason": "Preserve ordered Relationship endpoints, including multi-client/supplier Dependencies. TransitionUsage singleton endpoints normalize through the shared reference-list contract."
      }
    },
    {
      "field": "target",
      "kind": "ReferenceList",
      "source": {
        "classification": "kir-shape-override",
        "pilot_features": [
          "KerML::Relationship::target",
          "SysML::Relationship::target",
          "SysML::TransitionUsage::target"
        ],
        "reason": "Preserve ordered Relationship endpoints, including multi-client/supplier Dependencies. TransitionUsage singleton endpoints normalize through the shared reference-list contract."
      }
    },
    {
      "field": "imported_membership",
      "kind": "ReferenceList",
      "source": {
        "classification": "kir-shape-override",
        "pilot_features": [
          "KerML::MembershipImport::importedMembership",
          "KerML::Namespace::importedMembership",
          "SysML::MembershipImport::importedMembership",
          "SysML::Namespace::importedMembership"
        ],
        "reason": "MembershipImport has one imported membership; Namespace derives a collection. The shared reference-list contract retains singleton and ordered collection projections."
      }
    }
  ]
