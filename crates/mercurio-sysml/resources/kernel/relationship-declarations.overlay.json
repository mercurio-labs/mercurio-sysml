      "source_fields": [
        "subclassifier",
        "specific"
      ],
      "target_fields": [
        "superclassifier",
        "general"
      ],
      "many": false
    },
    "Specialization": {
      "source_fields": [
        "specific"
      ],
      "target_fields": [
        "general"
      ],
      "many": false
    },
    "FeatureTyping": {
