    "grammar": "org.omg.kerml.xtext/src/org/omg/kerml/xtext/KerML.xtext",
    "authorship": {
      "mode": "hand-curated-overlay",
      "reason": "Map pinned relationship grammar fields to KIR references. The existing generic AST metadata map carries a private serialized endpoint record through collect/resolve; it is consumed during emission and never emitted as a KIR property. Relationship identities are distinct from feature identities."
    },
    "metamodel": "org.omg.sysml/model/kerml.ecore#Relationship (source/target ordered unique; relatedElement union)",
    "chain_grammar": "org.omg.kerml.expressions.xtext/src/org/omg/kerml/expressions/xtext/KerMLExpressions.xtext#OwnedFeatureChain,OwnedFeatureChaining"
  },
  "rules": {
